{
  "name": "contech-dx-monorepo",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm -w @contech/web run dev",
    "build": "npm -w @contech/web run build",
    "build:lib": "npm -w sa-gantt-lib run build",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "clean": "npm exec --workspaces -- rm -rf node_modules .next dist"
  },
  "devDependencies": {
    "turbo": "^2.3.3"
  }
}
